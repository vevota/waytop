#!/usr/bin/env bash
set -e

pid=$(pidof wl-overlay)
if [ -z "$pid" ]; then
    echo "wl-overlay is not running" >&2
    exit 1
fi

socket="/tmp/wl-overlay-$pid.sock"
if [ ! -S "$socket" ]; then
    echo "socket $socket not found" >&2
    exit 1
fi

if [ "$1" = "pos" ] && [ -n "$2" ] && [ -n "$3" ]; then
    echo "pos $2 $3" | socat - UNIX-CONNECT:"$socket"
    exit $?
fi

coords=$(zenity --forms --title="wl-overlay" --text="Position" \
    --add-entry="X" --add-entry="Y" 2>/dev/null)
[ -z "$coords" ] && exit 0

echo "pos $coords" | socat - UNIX-CONNECT:"$socket"
