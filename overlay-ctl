#!/usr/bin/env bash

pid=$(pidof wl-overlay)
if [ -z "$pid" ]; then
    echo "wl-overlay is not running" >&2
    exit 1
fi

socket="/tmp/wl-overlay-$pid.sock"
if [ ! -S "$socket" ]; then
    echo "socket $socket not found" >&2
    exit 1
fi

send() {
    echo "$@" | socat - UNIX-CONNECT:"$socket"
}

send_pos() {
    send "pos $1 $2"
}

case "${1:-}" in
    pos)
        if [ -n "$2" ] && [ -n "$3" ]; then
            send_pos "$2" "$3"
            exit $?
        fi
        ;;
    size)
        if [ -n "$2" ]; then
            send "size $2"
            exit $?
        fi
        ;;
    quit)
        send "quit"
        exit $?
        ;;
esac

if [ -z "${1:-}" ]; then
    if command -v slurp >/dev/null 2>&1; then
        coords=$(slurp -f "%x %y" 2>/dev/null)
        if [ -n "$coords" ]; then
            send_pos ${coords% *} ${coords#* }
            exit $?
        fi
    fi
fi

exec >&2
echo "usage: $0 [command] [args]"
echo ""
echo "commands:"
echo "  (no args)       click to position via slurp"
echo "  pos <x> <y>     move to absolute position"
echo "  size <WxH>      resize (e.g. 640x360)"
echo "  quit            exit wl-overlay"
exit 1
