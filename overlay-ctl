#!/usr/bin/env bash

pid=$(pidof wl-overlay)
if [ -z "$pid" ]; then
    echo "wl-overlay is not running" >&2
    exit 1
fi

socket="/tmp/wl-overlay-$pid.sock"
if [ ! -S "$socket" ]; then
    echo "socket $socket not found" >&2
    exit 1
fi

send_pos() {
    echo "pos $1 $2" | socat - UNIX-CONNECT:"$socket"
}

if [ "$1" = "pos" ] && [ -n "$2" ] && [ -n "$3" ]; then
    send_pos "$2" "$3"
    exit $?
fi

if command -v slurp >/dev/null 2>&1; then
    coords=$(slurp -f "%x %y" 2>/dev/null)
    if [ -n "$coords" ]; then
        send_pos ${coords% *} ${coords#* }
        exit $?
    fi
fi

if command -v zenity >/dev/null 2>&1; then
    coords=$(zenity --forms --title="wl-overlay" --text="Position" \
        --add-entry="X" --add-entry="Y" 2>/dev/null)
    if [ -n "$coords" ]; then
        send_pos ${coords%|*} ${coords#*|}
        exit $?
    fi
fi

echo "install slurp or zenity to pick a position" >&2
exit 1
