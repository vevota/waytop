#!/usr/bin/env bash

wl_overlay=$(dirname "$0")/waytop
if [ ! -x "$wl_overlay" ]; then
    echo "waytop not found at $wl_overlay" >&2
    exit 1
fi

case "${1:-}" in
    pos)
        [ -n "$2" ] && [ -n "$3" ] && exec "$wl_overlay" -c "pos $2 $3"
        ;;
    size)
        [ -n "$2" ] && exec "$wl_overlay" -c "size $2"
        ;;
    toggle|quit)
        exec "$wl_overlay" -c "$1"
        ;;
esac

if [ -z "${1:-}" ]; then
    if command -v slurp >/dev/null 2>&1; then
        coords=$(slurp -f "%x %y" 2>/dev/null)
        [ -n "$coords" ] && exec "$wl_overlay" -c "pos ${coords% *} ${coords#* }"
    fi
fi

exec >&2
echo "usage: $0 [command] [args]"
echo ""
echo "commands:"
echo "  (no args)       click to position via slurp"
echo "  pos <x> <y>     move to absolute position"
echo "  size <WxH>      resize (e.g. 640x360)"
echo "  toggle          switch between locked (click-through) and unlocked"
echo "  quit            exit wl-overlay"
exit 1
